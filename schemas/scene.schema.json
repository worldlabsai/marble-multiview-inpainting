{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/worldlabsai/marble-multiview-inpainting/main/schemas/scene.schema.json",
  "title": "Marble multiview inpainting scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "views"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/view" }
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "image", "camera"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "depth": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "representation"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "representation": { "const": "camera_z" }
              }
            }
          ]
        },
        "camera": { "$ref": "#/$defs/camera" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extrinsics", "intrinsics"],
      "properties": {
        "extrinsics": { "$ref": "#/$defs/extrinsics" },
        "intrinsics": { "$ref": "#/$defs/intrinsics" }
      }
    },
    "extrinsics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "quaternion"],
      "properties": {
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "quaternion": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "coordinateSystem": {
          "type": "string",
          "enum": ["rdf", "rub"],
          "default": "rub"
        }
      }
    },
    "intrinsics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fx", "fy", "cx", "cy"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fx": { "type": "number", "exclusiveMinimum": 0 },
        "fy": { "type": "number", "exclusiveMinimum": 0 },
        "cx": { "type": "number" },
        "cy": { "type": "number" }
      }
    }
  }
}
